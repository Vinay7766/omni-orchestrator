{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni:schema:design-note",
  "title": "DesignNote",
  "description": ".agents/design-notes/<task>.json: the solution-design output required before coding a task (DSN-1..3, UND-3).",
  "type": "object",
  "required": ["formatVersion", "taskId", "problem", "constraints", "approaches", "chosen", "reason", "switchIf", "edgeCases", "generalisationCheck", "assumptions"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "$ref": "urn:omni:schema:common#/$defs/formatVersion" },
    "taskId": { "$ref": "urn:omni:schema:common#/$defs/id" },
    "problem": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" },
    "constraints": { "type": "array", "minItems": 1, "items": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" } },
    "approaches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "idea", "complexity", "risks"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "idea": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" },
          "complexity": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" },
          "risks": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" }
        }
      }
    },
    "singleApproachReason": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" },
    "chosen": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Name of the chosen approach (must match one of approaches[].name; checked in code)." },
    "reason": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" },
    "switchIf": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" },
    "edgeCases": { "type": "array", "minItems": 1, "items": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" } },
    "generalisationCheck": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" },
    "assumptions": { "type": "array", "items": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" } }
  },
  "if": { "properties": { "approaches": { "type": "array", "maxItems": 1 } } },
  "then": {
    "description": "Design it twice: one approach is only allowed with a stated reason.",
    "required": ["singleApproachReason"],
    "properties": { "singleApproachReason": { "$ref": "urn:omni:schema:common#/$defs/nonEmptyText" } }
  }
}
