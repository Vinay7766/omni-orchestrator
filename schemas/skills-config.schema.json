{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omni:schema:skills-config",
  "title": "SkillsConfig",
  "description": ".agents/skills.json: per-project overrides of the skill catalog (SKL-5).",
  "type": "object",
  "required": ["formatVersion", "skills"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "$ref": "urn:omni:schema:common#/$defs/formatVersion" },
    "skills": {
      "type": "object",
      "propertyNames": { "$ref": "urn:omni:schema:common#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "enabled": { "type": "boolean" },
          "phases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "anyOf": [{ "$ref": "urn:omni:schema:common#/$defs/phaseId" }, { "const": "all" }] }
          }
        }
      }
    }
  }
}
